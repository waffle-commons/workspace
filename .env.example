# -----------------------------------------------------------------------------
# Waffle Application Configuration
# -----------------------------------------------------------------------------
#
# PRECEDENCE: any variable also exported by the OS / Docker / Kubernetes wins
# over the value in this file. AppKernelFactory does:
#     array_merge((new DotEnv($root))->load(), getenv())
# array_merge is rightmost-wins on string keys, so the process environment
# silently overrides .env on collision. This file is intended for local-dev
# defaults; production values should come from your orchestrator.
#
# BOOLEAN NORMALIZATION: APP_DEBUG and DEBUG are normalized by DotEnv
# (true/yes/on/1 -> '1', false/no/off/0 -> '0'). The OS does NOT perform this
# normalization -- if you export APP_DEBUG=yes from your shell, Config::getBool()
# will throw because 'yes' is not a YAML boolean. Use true/false (or 1/0).
#
# See documentation/how-to/configuration.md for the full discussion.
# -----------------------------------------------------------------------------

# Application Environment (prod, dev, test)
APP_ENV=dev

# Debug Mode (true/false)
# In production, this should be set to false (0)
APP_DEBUG=true

# Application Secret
# This is used for encryption and signing.
# It is automatically generated during 'composer create-project'.
APP_SECRET=ChangeMeInProduction

# -----------------------------------------------------------------------------
# Docker / Infrastructure
# -----------------------------------------------------------------------------

# Server Name (Caddy)
# Used for automatic HTTPS generation in production
SERVER_NAME=localhost

# Exposed Ports (Docker Compose)
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443

# Redis — cache PSR-16 (waffle.cache.*), flux de la file (waffle.queue.*) et état
# partagé par tous les workers : seaux du limiteur de débit (NET-01) et circuits du
# disjoncteur (NET-03). `waffle-redis` est le nom du service dans docker-compose.yml.
# Sans Redis joignable, le cache du routeur ne se charge pas et le kernel ne démarre pas.
REDIS_DSN=redis://waffle-redis:6379

# -----------------------------------------------------------------------------
# CSRF Protection
# 32+ byte signing secret for stateless HMAC-signed CSRF tokens (Beta-1 / SEC-01).
# -----------------------------------------------------------------------------

WAFFLE_CSRF_SECRET=ChangeMeInProduction

# -----------------------------------------------------------------------------
# Universal Authentication Bridge (RFC-021)
# 32+ byte shared HMAC-SHA256 secret. Signs outbound X-Wfl-Assert-User identity
# assertions + the OAuth transaction cookie and validates the demo Bearer HS256
# JWTs. Consumed by waffle.auth.secret in config/app.yaml. The legacy monolith
# receives the SAME value via docker-compose so it can verify assertions. In
# prod a missing or short value aborts the boot (fail-closed, RFC-021 §4.2).
# -----------------------------------------------------------------------------

WAFFLE_AUTH_SECRET=ChangeMeInProduction

# -----------------------------------------------------------------------------
# Demo API key (X-Api-Key scheme) — authenticates the 'svc-demo' service account
# in the workspace demo (waffle.auth.demo_api_key). Demo-only; remove/replace in
# a real application.
# -----------------------------------------------------------------------------

WAFFLE_DEMO_API_KEY=ChangeMeInProduction

# -----------------------------------------------------------------------------
# Database (RFC-022) — local development credentials
# The PostgreSQL sandbox is provided by the `waffle-postgres` compose service;
# DB_HOST is that service name on waffle-network (use 127.0.0.1 from the host).
# Consumed by waffle.database.* in config/app.yaml, the compose service env
# (POSTGRES_DB/USER/PASSWORD), and the bin/waffle db:migrate command.
# Override these from your orchestrator in production.
# -----------------------------------------------------------------------------

DB_HOST=waffle-postgres
DB_PORT=5432
DB_NAME=waffle
DB_USER=waffle
DB_PASSWORD=ChangeMeInProduction

# [CARRY-01] Fenêtre de fraîcheur du ping du pool, en millisecondes : une connexion
# prouvée vivante il y a moins de ce délai est réutilisée sans `SELECT 1`. Si la base
# coupe ses connexions, des requêtes peuvent échouer pendant au plus ce délai.
# 0 ⇒ ping à chaque emprunt ; absente ou invalide ⇒ 500.
DB_PING_FRESHNESS_MS=500

# Délai d'ouverture d'une connexion à la base, en secondes (RFC-023 §3.2) : plus court
# que le timeoutSeconds de la sonde /readyz. Absent ou invalide ⇒ 2.
DB_CONNECT_TIMEOUT=2
