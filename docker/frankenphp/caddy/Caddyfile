#
# Waffle Framework : Caddyfile de FrankenPHP pour le workspace.
# Ce fichier configure le serveur web Caddy intégré à FrankenPHP.
#
{
	# Mode debug : des journaux plus détaillés pendant le développement
	debug

	# Mode worker et rechargement à chaud.
	# Garde l'application en mémoire et redémarre les threads à chaque modification.
	frankenphp {
		worker {
			file /waffle-commons/workspace/public/index.php
			num 4
			# Surveillance limitée aux répertoires de développement (évite les boucles infinies)
			watch /waffle-commons/workspace/.env
			watch /waffle-commons/*/src/**/*.php
			watch /waffle-commons/*/src/**/*.yaml
			watch /waffle-commons/workspace/app/**/*.php
			watch /waffle-commons/workspace/config/**/*.yaml
		}
	}

	order php_server before file_server
}

# Le serveur de l'environnement de développement. L'adresse du site vient de la variable
# SERVER_NAME (par défaut : localhost avec HTTPS automatique). Un service lancé avec
# SERVER_NAME=":80" (par exemple waffle-downstream dans la démo de trace distribuée) est
# alors servi en HTTP simple sur le réseau interne : pas de redirection HTTPS automatique
# entre services.
{$SERVER_NAME:localhost} {
	# Racine des documents : le répertoire public
	root * /waffle-commons/workspace/public
	# Compression des réponses
	encode zstd gzip
	# Transmet chaque requête au point d'entrée PHP de FrankenPHP
	php_server
}
